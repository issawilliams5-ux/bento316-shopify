# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Installed dependencies.
/node_modules/

# TypeScript incremental build cache.
/tsconfig.tsbuildinfo

# Next.js build output.
/.next/

# Local environment files. Never commit real credentials;
# .env.example is the tracked template.
.env
.env.local
.env.*.local

# /arena run state and /brag-slim renders (local, never committed)
.arena/
brag-output*/

# taste-skill working files (direction sheet, inspector screenshots)
.taste-skill/
