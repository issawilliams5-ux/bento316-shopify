NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Skyvern browser automation (https://github.com/Skyvern-AI/skyvern) — not deployed by default.
# Set only if you stand up the Skyvern service yourself; see CLAUDE.md.
SKYVERN_API_KEY=
SKYVERN_BASE_URL=http://localhost:8000

# OpenManus headless agent (https://github.com/FoundationAgents/OpenManus) — a
# dev/ops tool, not an app dependency. Read by ai-tools/setup.sh at install
# time to render the agent's OpenRouter config; see ai-tools/README.md.
OPENROUTER_API_KEY=

# screenshot-to-code (https://github.com/abi/screenshot-to-code) and OpenUI
# (https://github.com/wandb/openui) — screenshot/prompt → UI code. Dev tools,
# not app dependencies. ai-tools/setup.sh writes the set ones into
# ~/ai-tools/screenshot-to-code/backend/.env; OpenUI reads them from your
# environment at run time. At least one vision-capable key is required or
# neither tool can generate. See ai-tools/README.md.
# OPENAI_API_KEY is already declared above — both tools reuse it.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=
GROQ_API_KEY=

# Image generation for POST /api/image (lib/qwen-image.ts). Two backends;
# with neither configured the route returns 503 rather than calling out
# anywhere. Set QWEN_IMAGE_PROVIDER to force one ('fal' or 'self-hosted'),
# or leave it unset and whichever is configured is used — self-hosted wins
# if both are.
QWEN_IMAGE_PROVIDER=

# Hosted: fal.ai's Qwen Image 2.0. No GPU, pay per image. Note 2.0, not
# 2.1 — fal does not host 2.1, so transparent RGBA output and multi-image
# references are self-hosted only.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/qwen-image-2/text-to-image

# Self-hosted: your own OpenAI-compatible images endpoint, which is where
# Qwen-Image-2.1 itself runs. Needs a GPU.
#   vllm serve Qwen/Qwen-Image-2.1 --omni --port 8091
#   sglang: see the Qwen-Image 2.1 cookbook
QWEN_IMAGE_BASE_URL=
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_MODEL=Qwen/Qwen-Image-2.1

QWEN_IMAGE_TIMEOUT_MS=180000

# Per-user sliding-window rate limit on POST /api/image, counted in the
# usage_events table. Requires SUPABASE_SERVICE_ROLE_KEY above; without it the
# route fails closed rather than serving unlimited GPU time.
IMAGE_RATE_LIMIT=10
IMAGE_RATE_WINDOW_MINUTES=60
