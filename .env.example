# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# n8n Webhook (paste your n8n webhook trigger URL)
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/leadpulse

# Dify AI (for advanced lead qualification)
DIFY_API_KEY=your_dify_api_key
DIFY_API_URL=https://api.dify.ai/v1

# Twilio (for SMS sending - future)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Resend (for email sending - future)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=hello@yourdomain.com

# Stripe (for billing - future)
STRIPE_SECRET_KEY=sk_live_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key

# Admin
ADMIN_SECRET=change_this_to_a_strong_secret
