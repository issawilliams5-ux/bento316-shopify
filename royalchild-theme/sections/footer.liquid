<footer class="footer color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="footer__content grid grid-cols-1 md:grid-cols-4 gap-8 py-12">
      <div class="footer__block">
        <h3 class="h4 mb-4">{{ shop.name }}</h3>
        <p class="text-sm opacity-75">{{ section.settings.footer_text }}</p>
      </div>
      
      <div class="footer__block">
        <h4 class="font-bold mb-4">Quick Links</h4>
        <ul class="list-unstyled space-y-2 text-sm">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}" class="hover:underline">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      
      <div class="footer__block">
        <h4 class="font-bold mb-4">Customer Service</h4>
        <ul class="list-unstyled space-y-2 text-sm">
          <li><a href="{{ routes.search_url }}" class="hover:underline">Search</a></li>
          <li><a href="{{ pages.contact.url }}" class="hover:underline">Contact Us</a></li>
          <li><a href="{{ routes.shipping_rates_url }}" class="hover:underline">Shipping</a></li>
          <li><a href="{{ routes.returns_url }}" class="hover:underline">Returns</a></li>
        </ul>
      </div>
      
      <div class="footer__block">
        <h4 class="font-bold mb-4">Newsletter</h4>
        <p class="text-sm mb-4">Subscribe to get special offers and updates.</p>
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="flex gap-2">
            <input 
              type="email" 
              name="contact[email]" 
              placeholder="Enter your email" 
              class="input flex-1 px-4 py-2 border rounded"
              required
            >
            <button type="submit" class="button px-6 py-2 bg-black text-white rounded hover:bg-gray-800">
              Subscribe
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
    
    <div class="footer__bottom border-t py-6 text-center text-sm">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      <div class="payment-icons mt-4 flex justify-center gap-2">
        <svg class="w-10 h-6" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#E8E8E8"/><path d="M19.5 6C16.5 6 14 8.5 14 12C14 15.5 16.5 18 19.5 18C22.5 18 25 15.5 25 12C25 8.5 22.5 6 19.5 6Z" fill="#1A1F71"/></svg>
        <svg class="w-10 h-6" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#E8E8E8"/><circle cx="14" cy="12" r="5" fill="#EB001B"/><circle cx="24" cy="12" r="5" fill="#F79E1B" fill-opacity="0.8"/></svg>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer description",
      "default": "Welcome to our store. We offer the best products at great prices."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
