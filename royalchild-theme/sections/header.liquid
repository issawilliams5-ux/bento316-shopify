<header class="header-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="header__inner grid grid-cols-3 items-center">
      <div class="header__heading">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}">
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}">
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="h1">{{ shop.name }}</a>
        {%- endif -%}
      </div>
      
      <nav class="header__menu hidden md:block">
        <ul class="list-unstyled flex justify-center gap-8">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="link link--text capitalize hover:underline">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header__icons flex justify-end gap-4">
        <a href="{{ routes.cart_url }}" class="icon-cart" aria-label="{{ 'general.cart.title' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="cart-count badge {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
