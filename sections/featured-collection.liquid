{%- comment -%}
  Featured Collection Section
  Displays a grid of products from a selected collection with premium styling
  Supports: image hover, color swatches, quick add, badges, wishlist
{%- endcomment -%}

<div class="featured-collection section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header{% if section.settings.text_alignment == 'center' %} text-center{% elsif section.settings.text_alignment == 'right' %} text-right{% endif %}">
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_view_all and section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" class="btn btn-secondary">
            {{ section.settings.view_all_text | default: 'View All' }}
            <svg class="icon icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      <div class="featured-collection-grid" 
           style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-tablet: {{ section.settings.columns_tablet }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};">
        {%- assign products_to_show = section.settings.products_per_page | default: 8 -%}
        {%- for product in section.settings.collection.products limit: products_to_show -%}
          {%- render 'product-card', 
                     product: product, 
                     show_color_swatches: section.settings.show_color_swatches,
                     show_quick_add: section.settings.show_quick_add,
                     show_wishlist: section.settings.show_wishlist,
                     image_ratio: section.settings.image_ratio,
                     show_second_image: section.settings.show_second_image,
                     badge_style: section.settings.badge_style
          -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="featured-collection-actions text-center" style="margin-top: clamp(2rem, 4vw, 3rem);">
          <a href="{{ section.settings.collection.url }}" class="btn btn-primary btn-large">
            {{ section.settings.view_all_text | default: 'Shop All' }}
            <svg class="icon icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if section.settings.collection == blank -%}
        <div class="featured-collection-empty empty-state">
          <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
          <h3>Select a collection</h3>
          <p>Choose a collection in the theme editor to display products here.</p>
        </div>
      {%- else -%}
        <div class="featured-collection-empty empty-state">
          <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <path d="M16 16s-1.5-2-4-2-4 2-4 2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
          <h3>No products available</h3>
          <p>This collection doesn't have any products yet.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on tablet"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (4:5)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Product Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist button",
      "default": true
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge style",
      "options": [
        { "value": "modern", "label": "Modern" },
        { "value": "classic", "label": "Classic" },
        { "value": "minimal", "label": "Minimal" }
      ],
      "default": "modern"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "heading": "New Arrivals",
        "subheading": "Fresh Drops",
        "products_per_page": 8,
        "columns_desktop": 4,
        "columns_tablet": 3,
        "columns_mobile": 2,
        "show_view_all": true,
        "show_second_image": true,
        "show_color_swatches": true,
        "show_quick_add": true,
        "show_wishlist": true
      }
    }
  ]
}
{% endschema %}

<style>
.featured-collection {
  padding-block: var(--section-spacing-lg);
}

.section-header {
  margin-bottom: clamp(2rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: flex-start;
}

.section-header.text-center {
  align-items: center;
  text-align: center;
}

.section-header.text-right {
  align-items: flex-end;
  text-align: right;
}

.section-subheading {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-wide);
  color: var(--color-muted);
  margin: 0;
}

.section-heading {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  color: var(--color-text);
  margin: 0;
}

.featured-collection-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
  gap: clamp(1rem, 2vw, 1.5rem);
}

@media (min-width: 768px) {
  .featured-collection-grid {
    grid-template-columns: repeat(var(--grid-columns-tablet), 1fr);
  }
}

@media (min-width: 1024px) {
  .featured-collection-grid {
    grid-template-columns: repeat(var(--grid-columns-desktop), 1fr);
  }
}

.empty-state {
  text-align: center;
  padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  background: var(--color-bg-secondary);
  border-radius: var(--border-radius-lg);
}

.empty-state-icon {
  width: 4rem;
  height: 4rem;
  color: var(--color-muted);
  margin-bottom: 1rem;
}

.empty-state h3 {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin: 0 0 0.5rem;
}

.empty-state p {
  font-size: var(--font-size-base);
  color: var(--color-muted);
  margin: 0;
}

.featured-collection-actions {
  margin-top: clamp(2rem, 4vw, 3rem);
}

.btn-large {
  padding: 1rem 2.5rem;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
}
</style>
