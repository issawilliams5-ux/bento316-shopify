{
  "name": "Product",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Information"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable sticky Add to Cart on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Media Gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "grid", "label": "Grid" },
        { "value": "thumbnails", "label": "Thumbnails" }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "image_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_variants_sold_out",
      "label": "Hide sold-out variants",
      "default": false
    },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "text",
      "id": "accordion_1_heading",
      "label": "Accordion 1 heading",
      "default": "Product Details"
    },
    {
      "type": "richtext",
      "id": "accordion_1_content",
      "label": "Accordion 1 content"
    },
    {
      "type": "text",
      "id": "accordion_2_heading",
      "label": "Accordion 2 heading",
      "default": "Materials & Care"
    },
    {
      "type": "richtext",
      "id": "accordion_2_content",
      "label": "Accordion 2 content"
    },
    {
      "type": "text",
      "id": "accordion_3_heading",
      "label": "Accordion 3 heading",
      "default": "Shipping & Returns"
    },
    {
      "type": "richtext",
      "id": "accordion_3_content",
      "label": "Accordion 3 content"
    },
    {
      "type": "text",
      "id": "size_guide_heading",
      "label": "Size guide heading",
      "default": "Size Guide"
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Size guide content"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "new_badge_text",
      "label": "New badge text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "sold_out_badge_text",
      "label": "Sold out badge text",
      "default": "Sold Out"
    }
  ]
}
