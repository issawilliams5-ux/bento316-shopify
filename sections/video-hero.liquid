{%- style -%}
.video-hero {
  position: relative;
  width: 100%;
  height: var(--video-hero-height, 80vh);
  min-height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--color-bg-secondary);
}

.video-hero--fullscreen {
  height: 100vh;
  min-height: 100vh;
}

.video-hero__media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-hero__media--desktop {
  display: block;
}

.video-hero__media--mobile {
  display: none;
}

@media (max-width: 767px) {
  .video-hero__media--desktop {
    display: none;
  }
  
  .video-hero__media--mobile {
    display: block;
  }
}

.video-hero__poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.video-hero__content {
  position: relative;
  z-index: 2;
  max-width: var(--content-width);
  margin: 0 auto;
  padding: var(--spacing-lg);
  text-align: center;
  color: var(--color-text-inverse, #ffffff);
}

.video-hero__content--left {
  text-align: left;
  margin-left: 0;
}

.video-hero__content--right {
  text-align: right;
  margin-left: auto;
}

.video-hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, var(--overlay-opacity, 0.4));
  z-index: 1;
}

.video-hero__title {
  font-size: clamp(2.5rem, 8vw, 5rem);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  margin-bottom: var(--spacing-md);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.video-hero__subtitle {
  font-size: clamp(1rem, 3vw, 1.5rem);
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
  margin-bottom: var(--spacing-lg);
  max-width: 65ch;
}

.video-hero__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
  justify-content: center;
}

.video-hero__buttons--left {
  justify-content: flex-start;
}

.video-hero__buttons--right {
  justify-content: flex-end;
}

.video-hero__btn {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all 0.3s ease;
}

.video-hero__btn--primary {
  background: var(--color-btn-primary);
  color: var(--color-btn-primary-text);
  border: 2px solid var(--color-btn-primary);
}

.video-hero__btn--primary:hover {
  background: transparent;
  color: var(--color-btn-primary);
}

.video-hero__btn--secondary {
  background: transparent;
  color: var(--color-text-inverse, #ffffff);
  border: 2px solid var(--color-text-inverse, #ffffff);
}

.video-hero__btn--secondary:hover {
  background: var(--color-text-inverse, #ffffff);
  color: var(--color-bg);
}

.video-hero__controls {
  position: absolute;
  bottom: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 3;
  display: flex;
  gap: var(--spacing-xs);
}

.video-hero__control-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  backdrop-filter: blur(4px);
}

.video-hero__control-btn:hover {
  background: rgba(0, 0, 0, 0.8);
  border-color: #ffffff;
}

.video-hero__control-btn svg {
  width: 20px;
  height: 20px;
}

.video-hero--loading .video-hero__media {
  opacity: 0;
}

.video-hero--loaded .video-hero__media {
  opacity: 1;
  transition: opacity 0.5s ease;
}

@media (prefers-reduced-motion: reduce) {
  .video-hero__media,
  .video-hero__btn,
  .video-hero__control-btn {
    transition: none;
  }
}
{%- endstyle -%}

<section class="video-hero{% if section.settings.fullscreen %} video-hero--fullscreen{% endif %}{% if section.settings.desktop_video == blank and section.settings.mobile_video == blank %} video-hero--loading{% endif %}" 
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-loop="{{ section.settings.loop }}"
  data-muted="{{ section.settings.muted }}"
>
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="video-hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity }}"></div>
  {%- endif -%}

  {%- comment -%}Desktop Video{%- endcomment -%}
  {%- if section.settings.desktop_video != blank -%}
    <video
      class="video-hero__media video-hero__media--desktop"
      {% if section.settings.autoplay %}autoplay{% endif %}
      {% if section.settings.loop %}loop{% endif %}
      {% if section.settings.muted %}muted{% endif %}
      playsinline
      preload="metadata"
      poster="{% if section.settings.poster_image != blank %}{{ section.settings.poster_image | image_url: width: 1920 }}{% endif %}"
    >
      {{ section.settings.desktop_video }}
    </video>
  {%- elsif section.settings.hero_image != blank -%}
    <img
      class="video-hero__media video-hero__media--desktop"
      src="{{ section.settings.hero_image | image_url: width: 1920 }}"
      alt="{{ section.settings.heading | default: 'Hero' | escape }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}

  {%- comment -%}Mobile Video{%- endcomment -%}
  {%- if section.settings.mobile_video != blank -%}
    <video
      class="video-hero__media video-hero__media--mobile"
      {% if section.settings.autoplay %}autoplay{% endif %}
      {% if section.settings.loop %}loop{% endif %}
      {% if section.settings.muted %}muted{% endif %}
      playsinline
      preload="metadata"
      poster="{% if section.settings.poster_image_mobile != blank %}{{ section.settings.poster_image_mobile | image_url: width: 750 }}{% endif %}"
    >
      {{ section.settings.mobile_video }}
    </video>
  {%- elsif section.settings.hero_image_mobile != blank -%}
    <img
      class="video-hero__media video-hero__media--mobile"
      src="{{ section.settings.hero_image_mobile | image_url: width: 750 }}"
      alt="{{ section.settings.heading | default: 'Hero' | escape }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}

  {%- comment -%}Fallback Poster{%- endcomment -%}
  {%- if section.settings.poster_image != blank and section.settings.desktop_video == blank -%}
    <img
      class="video-hero__poster"
      src="{{ section.settings.poster_image | image_url: width: 1920 }}"
      alt=""
      loading="eager"
    >
  {%- endif -%}

  <div class="video-hero__content video-hero__content--{{ section.settings.text_alignment }}">
    {%- if section.settings.subheading != blank -%}
      <p class="video-hero__subtitle">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="video-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button_label_secondary != blank -%}
      <div class="video-hero__buttons video-hero__buttons--{{ section.settings.text_alignment }}">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="video-hero__btn video-hero__btn--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.button_label_secondary != blank -%}
          <a href="{{ section.settings.button_link_secondary }}" class="video-hero__btn video-hero__btn--secondary">
            {{ section.settings.button_label_secondary }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_controls and (section.settings.desktop_video != blank or section.settings.mobile_video != blank) -%}
    <div class="video-hero__controls">
      <button 
        type="button" 
        class="video-hero__control-btn" 
        data-action="play-pause"
        aria-label="Play/Pause video"
      >
        <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
      </button>

      {%- unless section.settings.muted -%}
        <button 
          type="button" 
          class="video-hero__control-btn" 
          data-action="mute-unmute"
          aria-label="Mute/Unmute video"
        >
          <svg class="icon-volume-on" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <svg class="icon-volume-off" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
      {%- endunless -%}
    </div>
  {%- endif -%}
</section>

<script>
class VideoHero extends HTMLElement {
  constructor() {
    super();
    this.videos = [];
    this.isPlaying = true;
    this.isMuted = this.dataset.muted === 'true';
  }

  connectedCallback() {
    this.init();
  }

  init() {
    this.findVideos();
    this.setupControls();
    this.setupLoadHandler();
    
    if (this.dataset.autoplay === 'true') {
      this.playAll();
    }
  }

  findVideos() {
    this.videos = Array.from(this.querySelectorAll('video'));
    
    this.videos.forEach(video => {
      video.addEventListener('loadeddata', () => {
        this.classList.add('video-hero--loaded');
        this.classList.remove('video-hero--loading');
      });

      video.addEventListener('ended', () => {
        if (this.dataset.loop === 'true') {
          video.currentTime = 0;
          if (this.isPlaying) video.play();
        } else {
          this.updatePlayButton(false);
        }
      });
    });
  }

  setupControls() {
    const playPauseBtn = this.querySelector('[data-action="play-pause"]');
    const muteBtn = this.querySelector('[data-action="mute-unmute"]');

    playPauseBtn?.addEventListener('click', () => this.togglePlay());
    muteBtn?.addEventListener('click', () => this.toggleMute());
  }

  setupLoadHandler() {
    // Handle lazy loading detection
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.loadVideos();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(this);
  }

  loadVideos() {
    this.videos.forEach(video => {
      if (video.dataset.src) {
        video.src = video.dataset.src;
      }
      if (this.dataset.autoplay === 'true' && this.isPlaying) {
        video.play().catch(() => {
          // Autoplay was prevented, likely due to unmuted video
          this.isPlaying = false;
          this.updatePlayButton(false);
        });
      }
    });
  }

  togglePlay() {
    this.isPlaying = !this.isPlaying;
    
    this.videos.forEach(video => {
      if (this.isPlaying) {
        video.play();
      } else {
        video.pause();
      }
    });

    this.updatePlayButton(this.isPlaying);
  }

  playAll() {
    this.isPlaying = true;
    this.videos.forEach(video => {
      video.play().catch(() => {
        this.isPlaying = false;
        this.updatePlayButton(false);
      });
    });
    this.updatePlayButton(true);
  }

  pauseAll() {
    this.isPlaying = false;
    this.videos.forEach(video => video.pause());
    this.updatePlayButton(false);
  }

  updatePlayButton(isPlaying) {
    const playIcon = this.querySelector('.icon-play');
    const pauseIcon = this.querySelector('.icon-pause');
    
    if (playIcon && pauseIcon) {
      playIcon.style.display = isPlaying ? 'none' : 'block';
      pauseIcon.style.display = isPlaying ? 'block' : 'none';
    }
  }

  toggleMute() {
    this.isMuted = !this.isMuted;
    
    this.videos.forEach(video => {
      video.muted = this.isMuted;
    });

    this.updateMuteButton(!this.isMuted);
  }

  updateMuteButton(isUnmuted) {
    const volumeOn = this.querySelector('.icon-volume-on');
    const volumeOff = this.querySelector('.icon-volume-off');
    
    if (volumeOn && volumeOff) {
      volumeOn.style.display = isUnmuted ? 'block' : 'none';
      volumeOff.style.display = isUnmuted ? 'none' : 'block';
    }
  }
}

customElements.define('video-hero-section', VideoHero);

document.addEventListener('shopify:section:load', (event) => {
  const section = event.target.querySelector('video-hero-section');
  if (section) {
    section.init();
  }
});
</script>

{%- schema -%}
{
  "name": "Video Hero",
  "tag": "section",
  "class": "video-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop video (16:9 recommended)"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video (9:16 recommended)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop fallback image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile fallback image"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Desktop poster image"
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Mobile poster image"
    },
    {
      "type": "header",
      "content": "Video Behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute video (required for autoplay)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show play/pause controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fullscreen",
      "label": "Full screen height",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.4
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Video Hero",
      "settings": {
        "autoplay": true,
        "loop": true,
        "muted": true,
        "show_controls": true,
        "overlay_opacity": 0.4,
        "text_alignment": "center",
        "heading": "Your Campaign Headline",
        "button_label": "Shop Now"
      }
    }
  ]
}
{%- endschema -%}
