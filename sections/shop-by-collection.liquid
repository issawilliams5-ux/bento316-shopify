{%- comment -%}
  Shop by Collection Section
  Grid of collection cards with imagery for category-based navigation
  Perfect for: Men/Women, Product Categories, Faith Collections
{%- endcomment -%}

<div class="shop-by-collection section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header{% if section.settings.text_alignment == 'center' %} text-center{% elsif section.settings.text_alignment == 'right' %} text-right{% endif %}">
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collections_to_show = section.settings.collections | compact -%}
    
    {%- if collections_to_show.size > 0 -%}
      <div class="shop-by-collection-grid" 
           style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-tablet: {{ section.settings.columns_tablet }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};">
        {%- for collection in collections_to_show limit: section.settings.collections_limit -%}
          <a href="{{ collection.url }}" class="collection-card">
            <div class="collection-card-media" style="--image-ratio: {{ section.settings.image_ratio }};">
              {%- if collection.image != blank -%}
                <img 
                  src="{{ collection.image | image_url: width: 800 }}" 
                  alt="{{ collection.image.alt | default: collection.title }}"
                  loading="lazy"
                  width="600"
                  height="750"
                  class="collection-card-image"
                >
              {%- elsif collection.all_products_count > 0 and collection.products.first.featured_image != blank -%}
                <img 
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}" 
                  alt="{{ collection.title }}"
                  loading="lazy"
                  width="600"
                  height="750"
                  class="collection-card-image"
                >
              {%- else -%}
                <div class="collection-card-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="M21 15l-5-5L5 21"/>
                  </svg>
                </div>
              {%- endif -%}
              
              {%- if section.settings.show_overlay -%}
                <div class="collection-card-overlay"></div>
              {%- endif -%}
            </div>
            
            <div class="collection-card-content">
              <h3 class="collection-card-title">{{ collection.title }}</h3>
              {%- if section.settings.show_product_count and collection.all_products_count > 0 -%}
                <p class="collection-card-count">{{ collection.all_products_count }} {{ section.settings.product_count_text | default: 'Products' }}</p>
              {%- endif -%}
              {%- if section.settings.show_shop_button -%}
                <span class="collection-card-btn">
                  {{ section.settings.shop_button_text | default: 'Shop Now' }}
                  <svg class="icon icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-by-collection-empty empty-state">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        <h3>Select collections</h3>
        <p>Choose collections to display in the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse By Category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Collections"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections"
    },
    {
      "type": "range",
      "id": "collections_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Maximum collections to show"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Columns on tablet"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1", "label": "Square (1:1)" },
        { "value": "1.25", "label": "Portrait (4:5)" },
        { "value": "1.5", "label": "Tall (2:3)" }
      ],
      "default": "1.25"
    },
    {
      "type": "header",
      "content": "Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show dark overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false
    },
    {
      "type": "text",
      "id": "product_count_text",
      "label": "Product count label",
      "default": "Products"
    },
    {
      "type": "checkbox",
      "id": "show_shop_button",
      "label": "Show shop button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop button text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection",
      "settings": {
        "subheading": "Browse By Category",
        "heading": "Shop Collections",
        "collections_limit": 6,
        "columns_desktop": 3,
        "columns_tablet": 2,
        "columns_mobile": 2,
        "image_ratio": "1.25",
        "show_overlay": true,
        "show_shop_button": true
      }
    }
  ]
}
{% endschema %}

<style>
.shop-by-collection {
  padding-block: var(--section-spacing-lg);
}

.section-header {
  margin-bottom: clamp(2rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: flex-start;
}

.section-header.text-center {
  align-items: center;
  text-align: center;
}

.section-header.text-right {
  align-items: flex-end;
  text-align: right;
}

.section-subheading {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-wide);
  color: var(--color-muted);
  margin: 0;
}

.section-heading {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  color: var(--color-text);
  margin: 0;
}

.shop-by-collection-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
  gap: clamp(1rem, 2vw, 1.5rem);
}

@media (min-width: 768px) {
  .shop-by-collection-grid {
    grid-template-columns: repeat(var(--grid-columns-tablet), 1fr);
  }
}

@media (min-width: 1024px) {
  .shop-by-collection-grid {
    grid-template-columns: repeat(var(--grid-columns-desktop), 1fr);
  }
}

.collection-card {
  display: block;
  text-decoration: none;
  color: inherit;
  group: collection-card;
}

.collection-card-media {
  position: relative;
  overflow: hidden;
  border-radius: var(--border-radius-md);
  aspect-ratio: calc(var(--image-ratio) / 1);
  background: var(--color-bg-secondary);
}

.collection-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.collection-card:hover .collection-card-image {
  transform: scale(1.05);
}

.collection-card-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  opacity: 0.3;
}

.collection-card-placeholder svg {
  width: 4rem;
  height: 4rem;
}

.collection-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 60%);
  opacity: 1;
  transition: opacity 0.3s ease;
}

.collection-card-content {
  padding: 1.25rem 0.5rem 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.collection-card-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin: 0;
  transition: color 0.3s ease;
}

.collection-card:hover .collection-card-title {
  color: var(--color-accent);
}

.collection-card-count {
  font-size: var(--font-size-sm);
  color: var(--color-muted);
  margin: 0;
}

.collection-card-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin-top: 0.25rem;
  transition: color 0.3s ease;
}

.collection-card-btn .icon-arrow {
  width: 16px;
  height: 16px;
  transition: transform 0.3s ease;
}

.collection-card:hover .collection-card-btn {
  color: var(--color-accent);
}

.collection-card:hover .collection-card-btn .icon-arrow {
  transform: translateX(4px);
}

/* Overlay variant - text over image */
.shop-by-collection[data-style="overlay"] .collection-card-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  color: #fff;
}

.shop-by-collection[data-style="overlay"] .collection-card-title {
  color: #fff;
}

.shop-by-collection[data-style="overlay"] .collection-card-count {
  color: rgba(255, 255, 255, 0.8);
}

.shop-by-collection[data-style="overlay"] .collection-card-btn {
  color: #fff;
}

.empty-state {
  text-align: center;
  padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  background: var(--color-bg-secondary);
  border-radius: var(--border-radius-lg);
}

.empty-state-icon {
  width: 4rem;
  height: 4rem;
  color: var(--color-muted);
  margin-bottom: 1rem;
}

.empty-state h3 {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin: 0 0 0.5rem;
}

.empty-state p {
  font-size: var(--font-size-base);
  color: var(--color-muted);
  margin: 0;
}
</style>
