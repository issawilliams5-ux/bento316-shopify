{%- liquid
  assign s = section.settings
-%}

<div class="is-section" id="is-{{ section.id }}" style="background-color: {{ s.background_color }}; color: {{ s.text_color }}; padding: {{ s.strip_padding }}px 20px;">
  <div class="is-inner">
    <div class="is-grid">
      {%- for block in section.blocks -%}
        <div class="is-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="is-icon" aria-hidden="true">{{ block.settings.icon }}</span>
          {%- endif -%}
          <div class="is-text">
            {%- if block.settings.headline != blank -%}
              <span class="is-headline">{{ block.settings.headline | escape }}</span>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <span class="is-subtext">{{ block.settings.subtext | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
#is-{{ section.id }} {
  --is-gap: 24px;
}
#is-{{ section.id }} .is-inner {
  max-width: 1100px;
  margin: 0 auto;
}
#is-{{ section.id }} .is-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: var(--is-gap);
}
#is-{{ section.id }} .is-item {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1 1 180px;
  max-width: 240px;
}
#is-{{ section.id }} .is-icon {
  font-size: 2rem;
  line-height: 1;
  flex-shrink: 0;
}
#is-{{ section.id }} .is-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
#is-{{ section.id }} .is-headline {
  font-weight: 700;
  font-size: 0.95rem;
  line-height: 1.3;
}
#is-{{ section.id }} .is-subtext {
  font-size: 0.8rem;
  opacity: 0.65;
  line-height: 1.3;
}
@media (max-width: 640px) {
  #is-{{ section.id }} .is-item {
    flex: 1 1 calc(50% - var(--is-gap));
    max-width: none;
  }
}
</style>

{% schema %}
{
  "name": "Icon Feature Strip",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "strip_padding",
      "label": "Top & bottom padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Icon item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext (optional)",
          "placeholder": "e.g. Ships in 2-3 days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Feature Strip",
      "blocks": [
        { "type": "icon_item", "settings": { "icon": "🚚", "headline": "Free Shipping", "subtext": "On all orders over $50" } },
        { "type": "icon_item", "settings": { "icon": "🔒", "headline": "Secure Payment", "subtext": "256-bit SSL encrypted" } },
        { "type": "icon_item", "settings": { "icon": "🔄", "headline": "Easy Returns", "subtext": "30-day money-back guarantee" } },
        { "type": "icon_item", "settings": { "icon": "💬", "headline": "24/7 Support", "subtext": "We're here to help anytime" } }
      ]
    }
  ]
}
{% endschema %}
