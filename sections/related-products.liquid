{%- comment -%}
  Related Products Section
  Displays recommended products based on Shopify recommendations or manual collection
  Used on product pages for cross-selling and upselling
{%- endcomment -%}

<div class="related-products section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header{% if section.settings.text_alignment == 'center' %} text-center{% elsif section.settings.text_alignment == 'right' %} text-right{% endif %}">
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign products_to_show = section.settings.products_limit | default: 4 -%}
    
    {%- if section.settings.source == 'automatic' and recommendation.products_count > 0 -%}
      <div class="related-products-grid" 
           style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-tablet: {{ section.settings.columns_tablet }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};">
        {%- for product in recommendation.products limit: products_to_show -%}
          {%- render 'product-card', 
                     product: product, 
                     show_color_swatches: section.settings.show_color_swatches,
                     show_quick_add: section.settings.show_quick_add,
                     show_wishlist: section.settings.show_wishlist,
                     image_ratio: section.settings.image_ratio,
                     show_second_image: section.settings.show_second_image,
                     badge_style: section.settings.badge_style
          -%}
        {%- endfor -%}
      </div>
    {%- elsif section.settings.source == 'collection' and section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- assign current_product_handle = product.handle -%}
      <div class="related-products-grid" 
           style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-tablet: {{ section.settings.columns_tablet }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};">
        {%- assign shown_count = 0 -%}
        {%- for related_product in section.settings.collection.products -%}
          {%- if related_product.handle != current_product_handle and shown_count < products_to_show -%}
            {%- render 'product-card', 
                       product: related_product, 
                       show_color_swatches: section.settings.show_color_swatches,
                       show_quick_add: section.settings.show_quick_add,
                       show_wishlist: section.settings.show_wishlist,
                       image_ratio: section.settings.image_ratio,
                       show_second_image: section.settings.show_second_image,
                       badge_style: section.settings.badge_style
            -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- if shown_count == 0 -%}
          <div class="related-products-empty empty-state">
            <p>This product is the only item in the selected collection.</p>
          </div>
        {%- endif -%}
      </div>
    {%- elsif section.settings.source == 'manual' and section.settings.products != blank -%}
      <div class="related-products-grid" 
           style="--grid-columns-desktop: {{ section.settings.columns_desktop }}; --grid-columns-tablet: {{ section.settings.columns_tablet }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};">
        {%- for manual_product in section.settings.products limit: products_to_show -%}
          {%- if manual_product.handle != product.handle -%}
            {%- render 'product-card', 
                       product: manual_product, 
                       show_color_swatches: section.settings.show_color_swatches,
                       show_quick_add: section.settings.show_quick_add,
                       show_wishlist: section.settings.show_wishlist,
                       image_ratio: section.settings.image_ratio,
                       show_second_image: section.settings.show_second_image,
                       badge_style: section.settings.badge_style
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="related-products-empty empty-state">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        <h3>No recommendations available</h3>
        <p>Configure product recommendations in the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Complete The Look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Product Source"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "automatic", "label": "Shopify recommendations (automatic)" },
        { "value": "collection", "label": "From a collection" },
        { "value": "manual", "label": "Manual product selection" }
      ],
      "default": "automatic"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when source is set to 'From a collection'"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Used when source is set to 'Manual product selection'"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on tablet"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (4:5)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Product Card Options"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist button",
      "default": false
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge style",
      "options": [
        { "value": "modern", "label": "Modern" },
        { "value": "classic", "label": "Classic" },
        { "value": "minimal", "label": "Minimal" }
      ],
      "default": "modern"
    }
  ],
  "presets": [
    {
      "name": "Related Products",
      "settings": {
        "subheading": "Complete The Look",
        "heading": "You May Also Like",
        "source": "automatic",
        "products_limit": 4,
        "columns_desktop": 4,
        "columns_tablet": 3,
        "columns_mobile": 2,
        "show_second_image": true,
        "show_color_swatches": true,
        "show_quick_add": true
      }
    }
  ]
}
{% endschema %}

<style>
.related-products {
  padding-block: var(--section-spacing-lg);
  background: var(--color-bg-secondary);
}

.section-header {
  margin-bottom: clamp(2rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: flex-start;
}

.section-header.text-center {
  align-items: center;
  text-align: center;
}

.section-header.text-right {
  align-items: flex-end;
  text-align: right;
}

.section-subheading {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-wide);
  color: var(--color-muted);
  margin: 0;
}

.section-heading {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  color: var(--color-text);
  margin: 0;
}

.related-products-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
  gap: clamp(1rem, 2vw, 1.5rem);
}

@media (min-width: 768px) {
  .related-products-grid {
    grid-template-columns: repeat(var(--grid-columns-tablet), 1fr);
  }
}

@media (min-width: 1024px) {
  .related-products-grid {
    grid-template-columns: repeat(var(--grid-columns-desktop), 1fr);
  }
}

.empty-state {
  text-align: center;
  padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  background: var(--color-bg-primary);
  border-radius: var(--border-radius-lg);
}

.empty-state-icon {
  width: 4rem;
  height: 4rem;
  color: var(--color-muted);
  margin-bottom: 1rem;
}

.empty-state h3 {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  margin: 0 0 0.5rem;
}

.empty-state p {
  font-size: var(--font-size-base);
  color: var(--color-muted);
  margin: 0;
}
</style>
