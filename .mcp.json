{
  "mcpServers": {
    "graft": {
      "command": "graft",
      "args": [
        "mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/mcp-browser.cjs",
        "chrome-devtools"
      ]
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com/"
    }
  }
}
